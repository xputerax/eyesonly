package views

type EditViewModel struct {
    EditId string
    PeekId string
    PeekURL string
    Title string
    Content string
}

templ Edit(vm *EditViewModel) {
    @Base("Edit Secret: " + vm.Title) {
        <div>
            <form action={templ.SafeURL("/edit/" + vm.EditId)} method="post">
                <h1>Editing secret {vm.Title}</h1>

                <p>
                    Peek URL: <a href={templ.SafeURL("/peek/" + vm.PeekId)}>{vm.PeekURL}</a>
                </p>

                <div>
                    <label>Title</label>
                    <input type="text" name="title" value={templ.EscapeString(vm.Title)} />
                </div>
                <div>
                    <label>Content</label>
                    <textarea name="content">{templ.EscapeString(vm.Content)}</textarea>
                </div>
                <div>
                    <input type="submit" value="Save" />
                </div>
            </form>
        </div>
    }
}